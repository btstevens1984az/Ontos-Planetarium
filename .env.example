# =============================================================================
# Ontos Planetarium — environment template
# Copy to .env and fill values. NEVER commit .env (gitignored).
# =============================================================================

# --- Core ---
ONTOS_APP_NAME=Ontos Planetarium
ONTOS_ENV=development
ONTOS_SECRET_KEY=change-me-to-a-long-random-string
ONTOS_ACCESS_TOKEN_MINUTES=30
ONTOS_REFRESH_TOKEN_DAYS=7
ONTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# SQLite by default (portable). For production use Postgres:
# ONTOS_DATABASE_URL=postgresql+asyncpg://ontos:ontos@db:5432/ontos
ONTOS_DATABASE_URL=sqlite+aiosqlite:///./data/ontos.db

# Demo ontology (synthetic RFC5737 data — safe for screenshots/videos)
ONTOS_DEMO_MODE=true
ONTOS_ALLOW_LIVE_COLLECT=false

# Bootstrap local admin (only used when DB has zero users)
ONTOS_BOOTSTRAP_ADMIN_USER=admin
ONTOS_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeNow!
ONTOS_BOOTSTRAP_ADMIN_EMAIL=admin@example.local

# --- Auth providers (enable what you need) ---
ONTOS_AUTH_LOCAL_ENABLED=true
ONTOS_AUTH_AZURE_AD_ENABLED=false
ONTOS_AUTH_LDAP_ENABLED=false

# Azure AD / Entra ID (OIDC)
# Register an app in Entra ID → Authentication → SPA or Web redirect URI
ONTOS_AZURE_TENANT_ID=
ONTOS_AZURE_CLIENT_ID=
ONTOS_AZURE_CLIENT_SECRET=
ONTOS_AZURE_REDIRECT_URI=http://localhost:8080/api/auth/azure/callback
ONTOS_AZURE_SCOPES=openid profile email offline_access

# Active Directory / LDAP (on-prem)
# Example: ldap://dc01.contoso.local:389  or  ldaps://dc01.contoso.local:636
ONTOS_LDAP_URL=
ONTOS_LDAP_BASE_DN=DC=contoso,DC=local
ONTOS_LDAP_USER_DN_TEMPLATE=CONTOSO\\{username}
# Optional service bind for group lookups (leave empty to bind as the user)
ONTOS_LDAP_BIND_DN=
ONTOS_LDAP_BIND_PASSWORD=
ONTOS_LDAP_USE_SSL=false
ONTOS_LDAP_START_TLS=false
# Group DN required for access (optional)
ONTOS_LDAP_REQUIRED_GROUP=

# Rate limiting
ONTOS_LOGIN_RATE_LIMIT=10/minute
